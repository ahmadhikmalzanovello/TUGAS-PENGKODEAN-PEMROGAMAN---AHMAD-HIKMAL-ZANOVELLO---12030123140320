<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Laporan Keuangan</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background-color: #f7f9fc;
      color: #333;
    }

    header {
      background-color: #2e5bff;
      color: white;
      padding: 20px 40px;
      text-align: center;
      font-size: 24px;
      font-weight: 600;
    }

    main {
      padding: 30px 40px;
    }

    h2 {
      font-size: 22px;
      margin-bottom: 20px;
    }

    .table-container {
      overflow-x: auto;
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
      background-color: #fff;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 800px;
    }

    th, td {
      padding: 14px 20px;
      text-align: left;
      border-bottom: 1px solid #eee;
    }

    th {
      background-color: #f0f3f8;
      font-weight: 600;
      color: #555;
    }

    tr:hover {
      background-color: #f9fbff;
    }

    @media (max-width: 768px) {
      header, main {
        padding: 20px;
      }

      h2 {
        font-size: 20px;
      }
    }
  </style>
</head>
<body>

  <header>
    Laporan Keuangan 2025
  </header>

  <main>
    <h2>Ringkasan Transaksi</h2>
    <div class="table-container">
      <table>
        <thead>
          <tr>
            <th>No</th>
            <th>Tanggal</th>
            <th>Keterangan</th>
            <th>Kategori</th>
            <th>Pemasukan (Rp)</th>
            <th>Pengeluaran (Rp)</th>
            <th>Saldo (Rp)</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>1</td><td>01/01/2025</td><td>Saldo Awal</td><td>Saldo</td><td>10.000.000</td><td>0</td><td>10.000.000</td></tr>
          <tr><td>2</td><td>02/01/2025</td><td>Penjualan Produk A</td><td>Pemasukan</td><td>5.000.000</td><td>0</td><td>15.000.000</td></tr>
          <tr><td>3</td><td>03/01/2025</td><td>Pembelian Bahan Baku</td><td>Operasional</td><td>0</td><td>3.000.000</td><td>12.000.000</td></tr>
          <tr><td>4</td><td>04/01/2025</td><td>Pembayaran Gaji</td><td>Karyawan</td><td>0</td><td>2.000.000</td><td>10.000.000</td></tr>
          <tr><td>5</td><td>05/01/2025</td><td>Penjualan Produk B</td><td>Pemasukan</td><td>3.000.000</td><td>0</td><td>13.000.000</td></tr>
          <tr><td>6</td><td>06/01/2025</td><td>Pembelian Alat</td><td>Investasi</td><td>0</td><td>1.500.000</td><td>11.500.000</td></tr>
          <tr><td>7</td><td>07/01/2025</td><td>Pemasukan dari Mitra</td><td>Pemasukan</td><td>4.000.000</td><td>0</td><td>15.500.000</td></tr>
          <tr><td>8</td><td>08/01/2025</td><td>Sewa Tempat</td><td>Operasional</td><td>0</td><td>2.500.000</td><td>13.000.000</td></tr>
          <tr><td>9</td><td>09/01/2025</td><td>Penjualan Online</td><td>Pemasukan</td><td>2.200.000</td><td>0</td><td>15.200.000</td></tr>
          <tr><td>10</td><td>10/01/2025</td><td>Biaya Marketing</td><td>Promosi</td><td>0</td><td>1.000.000</td><td>14.200.000</td></tr>
          <tr><td>11</td><td>11/01/2025</td><td>Pembelian Perlengkapan</td><td>Operasional</td><td>0</td><td>800.000</td><td>13.400.000</td></tr>
          <tr><td>12</td><td>12/01/2025</td><td>Penjualan Produk C</td><td>Pemasukan</td><td>1.500.000</td><td>0</td><td>14.900.000</td></tr>
          <tr><td>13</td><td>13/01/2025</td><td>Donasi Masuk</td><td>Lain-lain</td><td>1.000.000</td><td>0</td><td>15.900.000</td></tr>
          <tr><td>14</td><td>14/01/2025</td><td>Servis Kendaraan</td><td>Operasional</td><td>0</td><td>400.000</td><td>15.500.000</td></tr>
          <tr><td>15</td><td>15/01/2025</td><td>Penjualan Produk D</td><td>Pemasukan</td><td>3.500.000</td><td>0</td><td>19.000.000</td></tr>
        </tbody>
      </table>
    </div>
  </main>

</body>
</html>
