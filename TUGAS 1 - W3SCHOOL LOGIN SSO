<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SSO Universitas Diponegoro</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      background: url('https://upload.wikimedia.org/wikipedia/commons/thumb/d/df/Undip_Tembalang.jpg/1200px-Undip_Tembalang.jpg') no-repeat center center fixed;
      background-size: cover;
    }

    .overlay {
      background-color: rgba(255, 255, 255, 0.9);
      width: 100%;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .login-box {
      background-color: #fff;
      padding: 40px 30px;
      border-radius: 12px;
      width: 100%;
      max-width: 400px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
      text-align: center;
    }

    .login-box img {
      width: 90px;
      margin-bottom: 20px;
    }

    .login-box h2 {
      font-weight: 600;
      margin-bottom: 8px;
    }

    .login-box p {
      color: #444;
      font-size: 14px;
      margin-bottom: 25px;
    }

    input[type="text"] {
      width: 100%;
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 14px;
      margin-bottom: 16px;
    }

    .login-btn, .reset-btn {
      width: 100%;
      padding: 12px;
      font-size: 14px;
      font-weight: 600;
      border: none;
      border-radius: 6px;
      cursor: pointer;
    }

    .login-btn {
      background-color: #2e5bff;
      color: white;
      margin-bottom: 10px;
    }

    .reset-btn {
      background-color: #e53935;
      color: white;
    }

    .register-links {
      margin-top: 20px;
      font-size: 14px;
    }

    .register-links a {
      color: #e53935;
      text-decoration: none;
      font-weight: 500;
    }

    .register-links a:last-child {
      display: block;
      margin-top: 6px;
      color: #2e5bff;
    }
  </style>
</head>
<body>
  <div class="overlay">
    <div class="login-box">
      <img src="https://upload.wikimedia.org/wikipedia/id/9/9b/UNDIPOfficial.png" alt="Logo Undip">
      <h2>Single Sign On (SSO)</h2>
      <p>Universitas Diponegoro</p>
      <input type="text" placeholder="NIM/NIP/username/e-mail official Undip">
      <button class="login-btn">LOGIN</button>
      <button class="reset-btn">🔁 Reset Password</button>
      <div class="register-links">
        <p>Belum memiliki akun? <a href="#">Daftar sekarang!</a></p>
        <a href="#">Pendaftaran alumni klik disini</a>
      </div>
    </div>
  </div>
</body>
</html>
